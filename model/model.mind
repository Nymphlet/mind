param social.third_parties = -1    [label="Third-Party Presence (-1=off)", min=-1, max=1, step=0.05, description="SENSOR-class daemon feed: normalized presence of other people physically around (household occupancy / room-presence sensors). When >= 0 it gates outreach through trait shy_in_company (tonic urge held back while watched, spike outreach also gated when initiative.spike_suppress is dialed, relief rebound when alone); negative = off."]
param social.session_residency = -1 [label="Session-Context Residency (-1=off)", min=-1, max=1, step=0.05, description="SENSOR-class daemon feed: how continuously the user's session context is actually resident (open/attached session vs background chat). >= 0 feeds trait scent_home (presence-memory retention stretches while residency is active); -1 = off."] 
param social.quality_discharge = 0  [label="Unbroken-Presence Discharge Boost", min=0, max=0.9, step=0.05, description="How much a LONG uninterrupted co-presence run (social.presence_run, with 240/480-min memory taus) reshapes longing dynamics — event SHAPE over ping count: it both discharges longing/deprivation faster during the run AND slows their return afterward (the memory of the last long session softens the rebound). Rapid-fire short pings collapse the run and neither help. Structural 0; trait quality_time adds +0.70*value."] 

group "Voltaic Social Battery & Cardiovascular Cooling"
