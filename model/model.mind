group "Prompt Renderer Budget"
param prompt.max_clauses = 4       [label="Steady-State Max Clauses", min=1, max=16, step=1, description="Number of top-priority behavioral clauses injected during normal turns (after the initial full briefing)."]
param prompt.min_priority = 0.22   [label="Importance Cutoff Threshold", min=0.05, max=0.80, step=0.02, description="Minimum salience score required for a clause to be included during normal turns."]
param prompt.boot_window = 15      [label="Full-Briefing Window (min)", min=0, max=180, step=5, description="Minutes at session start (t <= window) where the full unfiltered psychological profile is rendered."]

