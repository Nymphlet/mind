param hw.loop_ambient_norm = -1.0   [label="Loop Ambient Normalized Floor", min=-2, max=0, step=0.1, description="Room temperature on the fitted 40..52C coolant normalization band: measured room ~28C sits 12C below the 40C idle floor = -1.0. The loop relaxes toward ambient + heat/conductance, so this is the off-scale cold anchor. Recalibrate with the band after host changes."]
