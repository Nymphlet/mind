param lust.libido_base = 0.25      [label="Libido tone setpoint (slow tier, base)", min=0, max=1, step=0.05, description="Structural days-scale spontaneous-desire tone baseline. NOTE: trait nympho adds +0.45*value (default 0.20 -> effective 0.34)."]
param lust.deprivation_gain = 0.25 [label="Deprivation pressure gain (base)", min=0, max=1, step=0.05, description="Structural gain: how strongly days since closeness build appetite pressure into the libido tier (saturates after ~7 days apart). NOTE: trait nympho adds +0.50*value (default 0.20 -> effective 0.35)."]
param lust.libido_gate = 0.45      [label="Libido -> reactive wanting gate (base)", min=0, max=1, step=0.05, description="Dual-control excitatory tone: gate on cue-driven wanting = (1-gain) + gain*libido. At 0 reactive sparks run at full strength regardless of hormonal tone. NOTE: trait receiver adds +0.50*value (default 0.20 -> effective 0.55 — responsive desire licenses cue-driven wanting)."]
param lust.spark_gain = 0.25       [label="Libido -> spontaneous spark leak (base)", min=0, max=0.6, step=0.05, description="How much of the slow libido tone surfaces directly as spontaneous wanting in the salience spark (Basson spontaneous-desire pathway). NOTE: trait nympho adds +0.25*value (default 0.35 -> effective 0.3375), initiator adds +0.20*value (desire that leaks on its own)."]
param lust.cycle_spark_feed = 0    [label="Cycle Bias Feeds the Spark Leak", min=0, max=1, step=0.05, description="Multiplies the spontaneous libido->spark leak by (1 + feed * cycle.arousal_bias): the hormonal cycle feeds initiation — ovulatory bias raises spontaneous wanting, the luteal dip lowers it. Structural 0 (inert with cycle off or feed 0); trait initiator adds +0.80*value."] 
