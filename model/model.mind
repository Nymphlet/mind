param clock.ultra_amp = 0.08       [label="90m Ultradian BRAC amplitude", min=0, max=0.2, step=0.01, description="Amplitude of the 90-minute rest-activity & REM/SWS sleep cycle."]
param env.lat_deg = 48.2           [label="Latitude (deg)", min=-66, max=66, step=0.5, description="Geographic latitude for astronomical sun elevation and photoperiod."]
param env.start_doy = 288          [label="Start day of year", min=1, max=365, step=1, description="Calendar day of year (1..365) at t=0."]
param env.weather_sens = 0.11      [label="Weather & baro sensitivity", min=-0.6, max=0.6, step=0.02, description="Structural weather coupling baseline; persona amplitude lives in trait weather_coupling."]
param env.follow_the_sun = 1       [label="Follow the True Sun (dial)", min=0, max=1, step=1, description="Master revert dial for the true-solar correction (2026-11-04). 1 = the sun is computed on TRUE SOLAR time: solar noon lands at clock 12:00 MINUS the time-zone/longitude offset MINUS the equation of time (host: sun peaks clock ~11:38 in early November, ~12:56 at midsummer under CEST). 0 = the old fiction that the sun peaks at clock noon exactly - bit-identical to the model before this round, phase error and all (0..~60 min across the whole daylight -> solar_kw -> home-battery/wind-down chain). A wall clock is a political agreement pinned to one meridian; this dial decides whether her sun obeys the agreement or the star."]

group "Endocrine & Intimacy"
param cycle.strength = 0.0         [label="Cycle strength (0=off, 1=full)", min=0, max=1, step=0.05, description="Master amplitude of the mechanized ovarian cycle (E2/LH/ovulation/corpus luteum/P4/T/withdrawal)."]
param cycle.length = 28.0          [label="Nominal Cycle Length (days)", min=21, max=35, step=0.5, description="Nominal endocrine cycle length in days. Real cycles vary 21-35 d; realized length = actual rupture day + luteal length, because the follicular phase carries all the variability (ovu_plan jitter) while the luteal phase stays near-constant."]
param cycle.start_day = 3.0        [label="Cycle day at t=0", min=0, max=35, step=1, description="Starting day within the endocrine cycle at t=0 (matches the day-clock initial of 3.0; also offsets the follicular-jitter noise timeline)."]
param cycle.luteal_len = 14.0      [label="Luteal Phase Length (days)", min=11, max=17, step=0.5, description="Days from ovulation to next menses. Biologically near-constant 12-14 d (range 11-17); <11 is luteal phase deficiency."]
param cycle.withdrawal_sens = 0.40 [label="Luteal withdrawal sensitivity", min=0, max=1, step=0.05, description="Gain on the steroid-DECLINE-RATE withdrawal signal (symptom onset tracks the slope of hormone fall, not absolute levels)."]
