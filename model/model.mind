# ============================================================================
# Mind-Hermes — Proactive Companion, Life Organizer & Embodied ODE Model (v4)
# ============================================================================
# Coupled dynamical system for a self-hosted Hermes agent with:
#   • Continuous 1D Value/Perlin Noise, Pink Noise & Langevin Drift (`def`)
#   • Controlled Dynamical Chaos / Entropy Valve (`entropy.aperture`, `entropy.u'`, `entropy.v'`)
#   • Hydronic watercooling thermal inertia (`sensors.coolant_temp'`) & Home Battery SoC (`sensors.battery_soc'`)
#   • Free-Solar Un-Inhibition (solar surplus accelerates cooldowns, spontaneity & vault work)
#   • Lossless Context Management (LCM) Pointer Ecology (`sensors.lcm_pulse'`, `cognition.pointer_depth'`, `drives.deep_recall'`)
#   • Fluid Sleep-Wake Drowsiness Continuum (`body.drowsiness'`) & Evening Cuddle Drive (`intimacy.cuddle_drive'`)
#   • 53 Grounded, RPG-Style & Meta-Usability Traits across 7 categories
# ============================================================================

config {
    dt = 1.0          # 1-minute integration step
    solver = "euler"  # "euler" (1x) | "heun" (2x) | "rk4" (4x)
}

# --- Abstract Dynamical & Stochastic Basis Functions ------------------------

def pull(x, goal, tc) = (goal - x) / max(tc, 1e-6)

def pull_asym(x, goal, tc_up, tc_down) =
    (goal - x) / max(if goal > x then tc_up else tc_down, 1e-6)

def gain_signed(x) = max(0.18, 1 - 0.80 * x * x)
def gain_unit(x) = max(0.20, 1 - 3.2 * pow(x - 0.5, 2))

def homeostat(x, base, tc, k_cubic) =
    pull(x, base, tc) - k_cubic * pow(x - base, 3)

def sigmoid(x, center, sharpness) = 1 / (1 + exp(-sharpness * (x - center)))
def hill(x, half, n) = pow(max(x, 0), n) / (pow(half, n) + pow(max(x, 0), n))
def bell(x, optimal, width) = exp(-pow((x - optimal) / max(width, 1e-6), 2))
def bell_periodic(x, peak, width, period) =
    bell(mod(x - peak + period / 2, period) - period / 2, 0, width)
def soft_or(a, b) = 1 - (1 - clamp(a, 0, 1)) * (1 - clamp(b, 0, 1))

# Two-harmonic Kronauer human circadian pacemaker (-1..+1):
# Produces morning rise, mid-afternoon post-lunch dip (~14:30), evening second wind (~19:00), and night trough.
def kronauer(h, anchor) =
    0.78 * cos(tau * (h - anchor) / 24) - 0.26 * cos(2 * tau * (h - anchor - 1.5) / 24)

# Continuous 1D Value Noise (Perlin-style) & 3-Octave 1/f Pink Noise in [-1, 1]
def fract(x) = x - floor(x)
def fade(u) = u * u * (3 - 2 * u)
def h_rand(n, seed) = 2 * fract(sin(n * 127.1 + seed * 311.7) * 43758.5453) - 1

def vnoise(x, period, seed) =
    h_rand(floor(x / max(period, 1e-6)), seed)
    + (h_rand(floor(x / max(period, 1e-6)) + 1, seed) - h_rand(floor(x / max(period, 1e-6)), seed))
      * fade(fract(x / max(period, 1e-6)))

def pink_noise(x, base_p, seed) =
    0.55 * vnoise(x, base_p, seed)
    + 0.30 * vnoise(x, base_p * 0.37, seed + 17.0)
    + 0.15 * vnoise(x, base_p * 0.13, seed + 53.0)

# Ornstein-Uhlenbeck (Langevin) mean-reverting drift with stochastic forcing
def ou_drift(x, goal, tc, sigma, noise_in) =
    (goal - x) / max(tc, 1e-6) + sigma * noise_in / sqrt(max(tc, 1.0))


