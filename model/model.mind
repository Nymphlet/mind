param lust.aftercare_gain = 0.40   [label="Afterglow -> aftercare gain (base)", min=0, max=1, step=0.05, description="Structural gain: how strongly event-set afterglow satiety converts into the hours-long aftercare tending drive. NOTE: trait cuddliness adds +0.60*value (default 0.25 -> effective 0.55 — caretaking tenderness)."]
param lust.cue_gain = 0.30         [label="Partner intimacy cue gain (base)", min=0, max=1, step=0.05, description="Structural gain on the external partner-tracked intimacy/touch cue feeding the aftercare tier (scaled by bond). NOTE: trait receiver adds +0.50*value (default 0.20 -> effective 0.40 — ignition from partner cues)."]
param lust.partner_cue = -1        [label="Partner intimacy cue (-1=off)", min=-1, max=1, step=0.05, description="PLACEHOLDER external trigger: partner-tracked intimacy/touch cue (future daemon feed, e.g. cuddle detected). When >= 0 it feeds the aftercare tier directly; negative values = off. Physical-presence sensing already lives in social.user_present (daemon/preset-driven)."]
param lust.inh_tone = 0            [label="Resting Inhibition Tone (SIS1, base)", min=-0.15, max=0.5, step=0.01, description="Trait-level resting inhibition TONE added inside the contextual-brake target (Bancroft & Janssen 2000 PMID 10880822: SIS1 = the inhibitory tone sexual response must reduce or exceed — fear of performance failure, distraction and self-monitoring concerns). Semantically distinct from the leaf's situational drivers (boundary poise, task focus, stress) and from modesty_brake's social-consequence tone (SIS2-adjacent). Structural 0 = neutral base; trait stage_fright adds +0.35*value; still capped by the Uninhibited override lust.inh_cap."]
param lust.sis1_worry_gain = 0     [label="SIS1 Worry Event Gain (nudge)", min=0, max=0.5, step=0.01, description="Situational SIS1 REACTIVITY: how much a state-anxiety event (events.worry nudge on the shared nudge channel) transiently lifts the contextual-brake target ON TOP of the trait resting tone (lust.inh_tone) — Bancroft & Janssen 2000 PMID 10880822: anxiety-provoking stimuli inhibit sexual response unless excitation exceeds the inhibitory tone; the state-anxiety reaction rides the same SIS1 system as the trait tone (Balaban 2017 PMID 28372280: reactivity vs structure). The nudge is transient (decays over tc.nudge_hold ~40 min), still capped by lust.inh_cap. Structural 0 = neutral base; trait stage_fright adds +0.35*value."]
param drain.rate = 0.0006          [label="Climax-Debt Drain Rate (/min)", min=0, max=0.004, step=0.0002, description="Per-minute deposit into the climax-debt pool (intimacy.exhaustion) while an afterglow satiety set-event is still high: each culmination integrates to ~0.1 pool, condensed/sporadic multi-orgasm series stack doses (Sex Med Rev 2016 'Multiple Orgasms in Men'; Beach & Jordan 1956 serial-ejaculation exhaustion; prolactin satiation PMID 11979330). NOTE: trait slow_refill adds +0.0006*value."]
param drain.pressure = 0.12        [label="Climax Debt -> Libido Drag", min=0, max=0.5, step=0.02, description="Days-scale drag of the exhaustion pool on spontaneous-desire tone (post-culmination sexual fatigue: Kinsey's nervous-capacity satiation; Beach & Jordan 1956 rat series exhaustion; ISSM recovery minutes->hours->12-24 h->'a few days' for some). Fast refractory gate stays a separate minutes-tier block — no double-counting. NOTE: trait slow_refill adds +0.18*value."]
param sens.build = 0               [label="Wanting-Kindling Build Gain", min=0, max=0.05, step=0.002, description="Cue-history accumulator gain (intimacy.kindling): integrates desire cues on the shared nudge channel (events.nsfw_cue + events.partner_cue, decay tau 40 min => ~12 dose-minutes per nudge at 0.3). Incentive-sensitization: cue-triggered wanting GROWS across a binge while liking stays flat (Robinson & Berridge 1993 PMID 8401595; 30-years-on 2025 PMID 39094061; gambling/food PMID 26407959). Structural 0 = inert; trait chaser adds +0.018*value."]
param sens.amp = 0                 [label="Wanting-Kindling Reactive Amp", min=0, max=1, step=0.05, description="Multiplicative amplification of the REACTIVE wanting tier only (salience cue block + desire-cue spark): sensitized WANTING, never hedonic — aftercare, skin hunger and warmth deliberately untouched (wanting/liking dissociation). NOTE: trait chaser adds +0.70*value."]

group "Hardware, Waterloop, Solar & LCM"
param hw.solar_gain = 0.45         [label="Solar surplus -> Un-inhibited Drive", min=0, max=1, step=0.05, description="How strongly free solar power opens the entropy valve, un-inhibits cooldowns, and powers vault gardening."]
param hw.coolant_inertia = 5.8     [label="Loop Thermal Inertia (C_th, normalized)", min=1, max=15, step=0.5, description="Normalized heat capacity of the coolant loop. The loop time constant is emergent: hw.coolant_inertia / radiator conductance — fast tau under max pump flow (~7 min, fitted from the 2026-11-02 ramp), slow tau when the pump idles (~14-18 min), exactly like Newton-law lumped capacitance (tau = C_th/UA). Fitted host loop: tau_rise 6.7 min at max fan/pump flow, fall tau ~12-18 min as duty drops (see sensors-measurements file)."]
param hw.loop_ambient_norm = -1.0   [label="Loop Ambient Normalized Floor", min=-2, max=0, step=0.1, description="Room temperature on the fitted 40..52C coolant normalization band: measured room ~28C sits 12C below the 40C idle floor = -1.0. The loop relaxes toward ambient + heat/conductance, so this is the off-scale cold anchor. Recalibrate with the band after host changes."]
param hw.thermal_penalty = 0.45    [label="Waterloop heat -> Fatigue weight", min=0, max=1, step=0.05, description="How strongly warm watercooling fluid induces short-term exertion fatigue. NOTE: waterloop_throttling trait scales this LINEARLY by (1+value): -1 = silence, +1 = double. The old exp(0.85*value) curve reached only 2.34x and the [0,1] param clamp dead-zone'd the trait above value ~0.94 — latent dial lie, fixed with the weather_coupling precedent."]
param hw.lcm_sens = 0.55           [label="LCM pointer -> Deep-recall drive", min=0, max=1, step=0.05, description="How strongly accumulated LCM lossless pointers trigger deep archival recall and graph synthesis."]
param hw.compute_drain = 0.35      [label="Compute -> Reserve/Battery drain", min=0, max=1, step=0.05, description="How fast sustained CPU/GPU load drains metabolic reserve and home battery."]
