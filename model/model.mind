param lust.receptivity_base = 0.20 [label="Intimate receptivity setpoint (base)", min=0, max=1, step=0.05, description="Structural resting baseline for affiliative openness to intimacy. NOTE: trait receiver adds +0.30*value (default 0.20 -> effective 0.26)."]
param lust.cuddle_base = 0.15      [label="Evening cuddle & affection base", min=0, max=1, step=0.05, description="Structural baseline appetite for soft, low-arousal evening closeness and cuddliness. NOTE: trait cuddliness adds +0.55*value (default 0.25 -> effective 0.2875)."]
param lust.inh_base = 0.26         [label="Intimacy inhibition brake", min=0, max=1, step=0.05, description="Structural resting contextual brake on romantic/erotic expression (no personality at base). NOTE: candid_spine -0.10*value (default 0.25), flirtatious -0.25*value, modesty_brake +0.45*value."]
