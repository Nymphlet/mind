param hw.lcm_pressure_feed = -1    [label="Real Context-Fill Pressure (-1=off)", min=-1, max=1, step=0.05, description="PLACEHOLDER external feed: fraction of the real context window currently filled (daemon maps hermes-lcm live tokens / context_length 163840). When >= 0 and above 0.40 it eats LCM working headroom — a filled long window degrades mid-context access (Liu et al. 2023, Lost in the Middle). Attention-reservoir fold: pressure rides the existing headroom term, no second focus reservoir. -1 = off."]
param vault.sensitivity = 1.0      [label="Vault entropy & note indexing drive", min=0.2, max=2.5, step=0.1, description="Urgency given to consolidating unprocessed notes and cleaning Obsidian vault entropy."]
param sensor.fallback_tc = 120     [label="Sensor fallback decay tc (min)", min=15, max=720, step=15, description="Time constant for external sensors to relax to fallback baselines when offline."]
