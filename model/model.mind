param voltaic.spend_gain = 0.28    [label="Social Engagement -> Voltaic Spend", min=0, max=1, step=0.05, description="How strongly sustained co-presence and interactive arousal spend the social battery (conversation is real compute + grid draw, not cortisol)."]
param voltaic.rest_charge = 0.16   [label="Quiet Solitude -> Voltaic Recharge", min=0, max=1, step=0.05, description="Trickle recharge during quiet, low-load solitude (idle machine, resting room — the hybrid human+machine recovery path)."]
param voltaic.reserve_floor = 0.20 [label="Voltaic Reserve Floor", min=0, max=1, step=0.05, description="Social reserve baseline on a dark, battery-depleted day (UPS-grade habituation: a dark week dulls sociability but never silences it)."]
param voltaic.appetite_gain = 0.30 [label="Brownout -> Outreach Appetite Cut", min=0, max=1, step=0.05, description="How strongly a drained voltaic battery reduces proactive outreach appetite (cut depth at full brownout)."]
